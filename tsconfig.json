{
    "compilerOptions": {
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "target": "ES2022",
        "module": "ES2022",
        "lib": ["ES2022", "DOM"],
        "allowJs": true,
        "checkJs": false,
        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "alwaysStrict": true,
        "noImplicitThis": true,
        "baseUrl": ".",
        "typeRoots": ["types", "lib/types/globals"],
        "skipLibCheck": true,
        "types": [],
        "paths": {
            "customModules/*": ["./customModules/*"]
        }
    },
    "include": [
        "./customModules/*/*.ts"
    ],
    "exclude": [
        "types/@girs/**/*.js",
        "node_modules"
    ]
}
